---
/** Daily 7-day net yield as filed, drawn at build time (SVG, no script). One or two series. */
interface Series { label: string; points: Array<[string, number]>; color: string }
interface Props { series: Series[]; caption: string }
const { series, caption } = Astro.props;
const W = 720, H = 240, L = 48, R = 12, T = 14, B = 30;
const all = series.flatMap((s) => s.points.map((p) => p[1]));
const lo = Math.floor(Math.min(...all) * 400) / 400, hi = Math.ceil(Math.max(...all) * 400) / 400;
const dates = [...new Set(series.flatMap((s) => s.points.map((p) => p[0])))].sort();
const t0 = Date.parse(dates[0]), t1 = Date.parse(dates[dates.length - 1]);
const x = (d: string) => L + ((Date.parse(d) - t0) / Math.max(1, t1 - t0)) * (W - L - R);
const y = (v: number) => T + (1 - (v - lo) / Math.max(1e-9, hi - lo)) * (H - T - B);
const path = (pts: Array<[string, number]>) => pts.map((p, i) => `${i ? 'L' : 'M'}${x(p[0]).toFixed(1)},${y(p[1]).toFixed(1)}`).join(' ');
const steps = 4; const ticks = Array.from({ length: steps + 1 }, (_, i) => lo + ((hi - lo) * i) / steps);
const months = dates.filter((d, i) => i === 0 || d.slice(0, 7) !== dates[i - 1].slice(0, 7));
const mlabel = (d: string) => new Date(`${d}T00:00:00Z`).toLocaleDateString('en-US', { month: 'short', timeZone: 'UTC' });
const last = series.map((s) => s.points[s.points.length - 1]);
---
<figure class="not-prose my-6" data-chrome>
  <svg viewBox={`0 0 ${W} ${H}`} class="h-auto w-full" role="img" aria-label={caption}>
    {ticks.map((v) => (<>
      <line x1={L} x2={W - R} y1={y(v)} y2={y(v)} stroke="#e2e8f0" stroke-width="1" />
      <text x={L - 6} y={y(v) + 4} text-anchor="end" font-size="11" fill="#475569">{(v * 100).toFixed(2)}%</text>
    </>))}
    {months.map((d) => <text x={x(d)} y={H - 10} font-size="11" fill="#475569">{mlabel(d)}</text>)}
    {series.map((s) => <path d={path(s.points)} fill="none" stroke={s.color} stroke-width="2" />)}
    {last.map((p, i) => <circle cx={x(p[0])} cy={y(p[1])} r="3.5" fill={series[i].color} />)}
  </svg>
  <figcaption class="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-sm text-navy-600">
    {series.map((s) => <span class="flex items-center gap-1.5"><span class="inline-block h-2.5 w-4 rounded-sm" style={`background:${s.color}`} aria-hidden="true"></span>{s.label}</span>)}
    <span>{caption}</span>
  </figcaption>
</figure>
