---
/** Side-by-side facts of two to four funds, as filed, with after-tax yields in three states. */
import { fund, pct, bn, usd, drag, quarterLabel, KIND_LABEL, META } from '../lib/data';
import { afterTax } from '../lib/engine/tax';
import { fundHref } from '../lib/common';
interface Props { tickers: string[]; heading: string; income?: number }
const { tickers, heading, income = 120000 } = Astro.props;
const fs = tickers.map(fund);
const at = (st: string) => fs.map((f) => pct(afterTax(f, { amount: 50000, state: st, filing: 'single', income }).afterTaxYield));
const rows: Array<[string, string[]]> = [
  ['Type', fs.map((f) => `${KIND_LABEL[f.k]}${f.st ? ` (${f.st})` : ''}`)],
  ['7-day net yield as filed', fs.map((f) => pct(f.y))],
  ['Gross 7-day yield of the fund', fs.map((f) => (f.g != null ? pct(f.g) : 'n/a'))],
  ['Expenses taken from the yield (expense drag)', fs.map((f) => { const d = drag(f); return d != null ? pct(d) : 'n/a'; })],
  ['State-tax-free part (U.S. government debt), last month end', fs.map((f) => (f.k.endsWith('muni') ? 'n/a' : pct(f.usob, 1)))],
  ...META.quarters.map((q): [string, string[]] => [`U.S. government debt, ${quarterLabel(q)}`, fs.map((f) => (f.k.endsWith('muni') ? 'n/a' : f.q[q] != null ? pct(f.q[q], 1) : 'n/a'))]),
  ['Average days until holdings repay or reset their rate (weighted average maturity)', fs.map((f) => `${f.wam} days`)],
  ['Average days until holdings are paid back in full (weighted average life)', fs.map((f) => `${f.wal} days`)],
  ['Assets in the share class', fs.map((f) => bn(f.assets))],
  ['Minimum initial investment on file', fs.map((f) => (f.min > 0 ? usd(f.min) : 'None reported'))],
  ['After tax, California', at('CA')],
  ['After tax, New York (outside NYC)', at('NY')],
  ['After tax, Texas', at('TX')],
];
---
<section data-chrome class="prose prose-slate mt-8 max-w-none">
  <h2>{heading}</h2>
  <div class="overflow-x-auto"><table>
    <thead><tr><th></th>{fs.map((f) => { const h = fundHref(f.t); return <th class="text-right">{h ? <a href={h}>{f.t}</a> : f.t}</th>; })}</tr></thead>
    <tbody>{rows.map(([l, v]) => <tr><td>{l}</td>{v.map((x) => <td class="tabular-nums text-right">{x}</td>)}</tr>)}</tbody>
  </table></div>
  <p>{`The after-tax rows use one fixed example, the same in every side-by-side table on this site: a single filer with $${income.toLocaleString('en-US')} of taxable income, and this site’s estimate of the state-tax-free part. Your own figures go in the calculator above.`}</p>
</section>
