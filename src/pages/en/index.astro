---
/** Pillar page: every retail share class ranked after federal and state tax, then the explanation. */
import PageLayout from '../../layouts/PageLayout.astro';
import Comparator from '../../components/calc/Comparator';
import Sources from '../../components/Sources.astro';
import { organizationSchema, websiteSchema, webApplicationSchema, webPageSchema, faqSchema, type FAQItem } from '../../lib/seo';
import { FUNDS, META, TBILLS, fund, pct, bn, usd, day, drag, monthName, avgYield, rank, KIND_LABEL, KIND_LEGEND, YIELD_DAYS } from '../../lib/data';
import { fiftyTest, afterTax } from '../../lib/engine/tax';
import { simpleOfApy } from '../../components/calc/AfterTaxCalc';
import { ROWS, METHOD, href, PAGES } from '../../lib/common';
import { GROUPS } from '../../i18n/nav';
import { title as fitTitle, desc as fitDesc } from '../../lib/snippet';

const asOf = day(META.month);
const month = monthName(META.month.slice(0, 7));
const n = FUNDS.length;
const total = FUNDS.reduce((s, f) => s + f.assets, 0);
const kinds = ['treasury-only', 'treasury', 'government', 'prime', 'muni', 'state-muni'] as const;
const byKind = kinds.map((k) => ({ k, ...avgYield((f) => f.k === k) }));
// Same set as the California page and the 50% guide (test naïf 2026-11-08: « 92 of 197 » here, « 92 of 221 » there).
const govs = FUNDS.filter((f) => f.k === 'government' || f.k === 'treasury' || f.k === 'treasury-only');
const fails = govs.filter((f) => fiftyTest(f.q) === 'fails');
const govYield = byKind.find((x) => x.k === 'government')!.mean;
const muniYield = byKind.find((x) => x.k === 'muni')!.mean;
const drags = FUNDS.map((f) => drag(f)).filter((x): x is number => x != null).sort((a, b) => a - b);
const ca = rank({ amount: 50000, state: 'CA', filing: 'single', income: 120000 });
const tx = rank({ amount: 50000, state: 'TX', filing: 'single', income: 120000 });
const topBefore = [...FUNDS].sort((a, b) => b.y - a.y)[0];
const caPosOfTop = ca.findIndex((x) => x.f.t === topBefore.t) + 1;
const vmf = fund('VMFXX'), vus = fund('VUSXX'), swv = fund('SWVXX'), sns = fund('SNSXX');
// A 4.00% APY savings account for the same example, through the same engine as the savings page (test naïf 2026-11-09:
// « 3,03 % ? Ma banque fait 4 %, ce site ne me concerne pas » : after tax read against a rate before tax).
const BANK_APY = 0.04;
const bankCa = afterTax({ y: simpleOfApy(BANK_APY), k: 'prime', usob: 0, q: { x: 0 } }, { amount: 50000, state: 'CA', filing: 'single', income: 120000 });
const caOf = (t: string) => ca.find((x) => x.f.t === t)!.r;
const txOf = (t: string) => tx.find((x) => x.f.t === t)!.r;
/** Gap in points between two yields as shown (rounded to 0.01 first), so the reader can check it against the figures. */
const gapPts = (a: number, b: number) => ((Math.round(a * 10000) - Math.round(b * 10000)) / 100).toFixed(2);

const title = fitTitle(['Money Market Fund Yields After Tax, by State, as Filed', 'Money Market Fund Yields After Tax by State, as Filed']);
const description = fitDesc([
  `Money market fund yields for ${n} retail share classes as filed with the SEC for ${asOf}, ranked by what they leave after federal and state income tax.`,
  `Money market fund yields of ${n} retail share classes as filed with the SEC for ${asOf}, ranked by what they leave you after federal and state income tax.`,
]);
const faqs: FAQItem[] = [
  { q: 'Which money market fund has the highest yield after tax?', a: `It depends on your state and income, which is why the table above asks for them. For a single Californian with $120,000 of taxable income, the top fund on the ${month} reports was ${ca[0].f.t} at ${pct(ca[0].r.afterTaxYield)} after tax; in Texas it was ${tx[0].f.t} at ${pct(tx[0].r.afterTaxYield)}. Past yields, not a forecast.` },
  { q: 'Is a money market fund safe?', a: `It is not a bank deposit and is not insured by the FDIC (the U.S. agency that insures bank deposits). Government and Treasury funds lend for days or weeks, mostly to the U.S. government; federal rules limit them to short, high-quality debt and make them keep cash on hand. Losses are uncommon but possible.` },
  { q: 'Why is the yield here different from the fund company’s site?', a: `This site uses the yield each fund reported to the Securities and Exchange Commission (the U.S. markets regulator) for the last business day of ${month}, so every fund is on the same date. Fund companies publish a new figure every business day.` },
  // La recette (check-trame) veut 6 à 8 questions sur la page pilier : les trois de plus, courtes, après les trois essentielles.
  { q: 'How often is this page updated?', a: `By hand, once a month, after funds file their next monthly reports (they have five business days after month end). There is no automatic update, so the figures age between two updates. The current data was filed from ${day(META.filedFrom)} to ${day(META.filedTo)}.` },
  { q: 'Is this site giving investment advice?', a: `No. Money Fund Yields is an independent site, not an investment adviser, and it sells no funds. It ranks past yields and applies published tax rates to the situation you type. The result is an estimate; check a fund’s documents and tax letter before acting.` },
  { q: 'Do municipal money funds beat taxable ones?', a: `Sometimes, at high incomes. Municipal funds lend to states and cities, and their dividends are free of federal tax. They averaged ${pct(muniYield)} on the latest data, against ${pct(govYield)} for government funds. The municipal fund keeps more only when tax takes more than ${pct(1 - muniYield / govYield, 0)} of a taxable dividend, federal and state combined.` },
];
const jsonLd = [organizationSchema('en'), websiteSchema('en'), webApplicationSchema({ name: 'Money market fund after-tax yield comparator', description, path: '/en/', lang: 'en' }), webPageSchema({ name: title, description, path: '/en/', lang: 'en' }), faqSchema(faqs, 'en')];
---
<PageLayout title={title} description={description} lang="en" jsonLd={jsonLd} faqs={faqs} showAuthor={true}>
  <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Money market fund yields after tax: which keeps the most?</h1>
  {/* Réponse en dollars, sans sigle (testeurs naïfs du 2026-11-10, règles 2 et 4) ; chiffres lus dans le moteur. */}
  <p data-chrome class="mb-3 mt-2 text-navy-700">Money market fund yields after tax depend on your state and income. <strong>Example:</strong> one person in California, $120,000 of taxable income, $50,000 saved. The best money fund keeps <strong>{usd(ca[0].r.net)} a year</strong> after tax; a bank savings account paying {pct(BANK_APY)} a year keeps <strong>{usd(bankCa.net)}</strong>, because California taxes bank interest in full.</p>
  <nav data-chrome aria-label="Where to start" class="mb-3 flex flex-wrap gap-2 text-sm">
    <a href="#find-fund" class="rounded-full border border-accent-300 bg-accent-50 px-3 py-1.5 font-semibold text-accent-800 hover:bg-accent-100">I hold a fund (SPAXX…) →</a>
    <a href="/en/money-market-vs-high-yield-savings/" class="rounded-full border border-accent-300 bg-accent-50 px-3 py-1.5 font-semibold text-accent-800 hover:bg-accent-100">My cash is in a bank →</a>
    <a href="/en/money-market-fund-rules/" class="rounded-full border border-navy-200 bg-white px-3 py-1.5 font-semibold text-navy-800 hover:bg-navy-50">Is it safe? →</a>
    <a href="#rank" class="rounded-full border border-navy-200 bg-white px-3 py-1.5 font-semibold text-navy-800 hover:bg-navy-50">Not sure? Start here →</a>
  </nav>
  <p data-chrome class="mb-3 text-sm text-navy-700"><strong>Not a bank account:</strong> not FDIC-insured; it can lose money, though rarely (<a class="font-semibold underline" href="/en/money-market-fund-rules/">what protects it</a>). Not investment advice.</p>
  <div id="rank" class="scroll-mt-20"><Comparator client:load rows={ROWS} asOf={month} methodHref={METHOD} series={META.series} yieldDays={YIELD_DAYS} /></div>

  <details class="mt-8 rounded-xl border border-navy-200 p-4 sm:p-5">
    <summary class="cursor-pointer text-lg font-bold text-navy-900">How the ranking works: tax by state and where the numbers come from</summary>
  <div class="prose prose-slate mt-6 max-w-none">
    <h2>Why a money market fund’s yield is not what you keep after tax</h2>
    <p>Federal income tax takes the same share of every taxable fund’s dividend. Your state is where funds differ. No state may tax the interest the U.S. government pays, so the part of a dividend earned on Treasury bills and on some agency debt is free of state tax. Interest from banks, companies and short loans to banks (called repo) is taxed. Take one person in California with $120,000 of taxable income. Vanguard Federal (VMFXX) paid {pct(vmf.y)} before tax and keeps {pct(caOf('VMFXX').afterTaxYield)}. Vanguard Treasury (VUSXX), which holds only Treasuries, paid {pct(vus.y)} and keeps {pct(caOf('VUSXX').afterTaxYield)}. California, Connecticut and New York add a catch: a fund that kept less than half its money in U.S. government debt at a quarter end loses the state break for the whole year. In the data, {fails.length} of {govs.length} government and Treasury versions missed that line; the <a href="/en/fifty-percent-rule/">50% rule guide</a> lists them.</p>

    <h2>Where the numbers come from</h2>
    <p>Every money fund reports its yield and its holdings to the Securities and Exchange Commission (the U.S. markets regulator) each month. This site reads the reports for {month}: {META.classes} versions of {META.series} funds, leaving out versions with a minimum above $100,000. It then applies the 2026 federal tax brackets and each state’s latest published rates. The figures are updated by hand once a month, so they are a few weeks old. The <a href={METHOD}>data and method page</a> gives each step.</p>
  </div>
  </details>
  {/* Testeurs naïfs du 2026-11-10 (règle 3) : trois sections de texte au plus, une idée par phrase ; le détail est sur la page de méthode. */}
  <section data-chrome class="mt-8 rounded-xl border border-navy-200 bg-navy-50 p-4 text-navy-800 sm:p-5">
    <h2 class="text-lg font-bold text-navy-900">In short</h2>
    <ul class="mt-2 list-disc space-y-1 pl-5">
      <li>Funds are ranked by what you keep after federal and state income tax, not by the yield before tax: your state taxes some funds and not others.</li>
      <li>Yields come from the funds’ {month} reports, so they are a few weeks old; the fund’s own site shows today’s figure.</li>
      <li><strong>Not a bank account:</strong> a money market <strong>fund</strong> is an investment, not insured by the FDIC (the U.S. agency that insures bank deposits). A bank’s money market <strong>account</strong> is a deposit, insured up to $250,000 per depositor, per bank. The shared name causes most of the confusion. <a class="underline" href="/en/money-market-fund-rules/">What protects a fund</a>.</li>
      <li>Seeing SPAXX or VMFXX in your brokerage account? That is the fund where Fidelity or Vanguard keeps your uninvested cash: <a class="font-semibold text-accent-700 underline" href="/en/spaxx/">SPAXX</a> · <a class="font-semibold text-accent-700 underline" href="/en/vmfxx/">VMFXX</a> · <a class="font-semibold text-accent-700 underline" href="/en/spaxx-vs-vmfxx/">SPAXX vs VMFXX</a>.</li>
      <li>No brokerage account? A money fund is bought through one, opened with a fund company or a broker, which sets the funds offered, the minimum and any fee.</li>
    </ul>
  </section>
  <section data-chrome class="mt-10">
    <h2 class="mb-3 text-xl font-bold text-navy-900">Pages on this site</h2>
    {[...GROUPS].sort((a, b) => (a.id === 'compare' ? -1 : b.id === 'compare' ? 1 : 0)).map((g) => { const ps = PAGES.filter((p) => p.group === g.id); return <details class="mb-3 rounded-lg border border-navy-200 px-3 py-2"><summary class="cursor-pointer font-semibold text-navy-900">{g.label} <span class="text-sm font-normal text-navy-600">· {ps.length} pages: {ps.slice(0, 2).map((p) => p.menu ?? p.nav).join('; ')}…</span></summary><ul class="mt-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
      {ps.map((p) => <li><a href={href(p.id)} class="block rounded-lg border border-navy-200 px-4 py-3 hover:border-accent-300 hover:bg-accent-50"><span class="font-semibold text-accent-700">{p.menu ?? p.nav}</span><span class="block text-sm text-navy-600">{p.card}</span></a></li>)}
    </ul></details>; })}
  </section>


  <details class="mt-8 rounded-xl border border-navy-200 p-4" data-chrome><summary class="cursor-pointer font-semibold text-navy-900">Sources and data credits</summary><div class="prose prose-slate mt-2 max-w-none">
    <Sources lang="en" intro="Fund yields and holdings come from SEC filings, and every tax rule and rate from the IRS, state tax agency or statute listed here, each read on" />
    <p>Fund data: Securities and Exchange Commission, Form N-MFP, as filed; public information. This site is not affiliated with the Commission or with any fund company. Fund names and tickers belong to their owners and are used only to identify the funds. Total assets of the share classes in the table: {bn(total)}.</p>
  </div></details>
</PageLayout>
